<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Shade Lyrics — Écoutez vos morceaux préférés, lisez les paroles en temps réel et profitez d'une expérience musicale ultra-premium.">
  <meta name="theme-color" content="#030712">

  <title>Shade Lyrics — Ultra Premium Music Experience</title>

  <!-- Preconnect & Preload pour zéro latence -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap">

  <!-- Style critique inliné pour un rendu FCP instantané -->
  <style>
    :root {
      --bg-color: #030712;
      --card-bg: rgba(15, 23, 42, 0.7);
      --border-color: rgba(255, 255, 255, 0.08);
      --accent-blue: #00f0ff;
      --accent-indigo: #6366f1;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --radius-lg: 20px;
      --radius-md: 12px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-main);
      font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      min-height: 100vh;
      overflow-x: hidden;
      line-height: 1.6;
    }

    /* Ambiance Lumineuse Bleu & Noir */
    .ambient-glow {
      position: fixed;
      border-radius: 50%;
      filter: blur(140px);
      z-index: -1;
      pointer-events: none;
      will-change: transform;
    }
    .glow-1 { top: -10%; left: -10%; width: 50vw; height: 50vw; background: rgba(0, 240, 255, 0.08); }
    .glow-2 { bottom: -10%; right: -10%; width: 60vw; height: 60vw; background: rgba(99, 102, 241, 0.12); }
    .glow-3 { top: 35%; left: 25%; width: 45vw; height: 45vw; background: rgba(15, 23, 42, 0.8); }

    /* Layout & Utilities */
    .container {
      width: 100%;
      max-width: 1100px;
      margin: 0 auto;
      padding: 2rem 1.5rem;
    }

    .hidden {
      display: none !important;
    }

    /* Navigation */
    .navbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.25rem 2rem;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      background: rgba(3, 7, 18, 0.75);
      border-bottom: 1px solid var(--border-color);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .logo-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      cursor: pointer;
      user-select: none;
    }

    .logo-svg-wrapper {
      width: 44px;
      height: 44px;
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .logo-brand:hover .logo-svg-wrapper {
      transform: scale(1.08) rotate(-3deg);
    }

    .brand-title {
      font-weight: 800;
      font-size: 1.25rem;
      letter-spacing: 2px;
      background: linear-gradient(135deg, #ffffff 30%, var(--accent-blue));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .brand-subtitle {
      font-size: 0.65rem;
      letter-spacing: 4px;
      color: var(--accent-blue);
      display: block;
      font-weight: 600;
    }

    /* Hero & Recherche */
    .hero-section {
      text-align: center;
      padding: 5rem 1rem 3rem;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .hero-title {
      font-size: 3rem;
      font-weight: 800;
      letter-spacing: -1px;
      margin-bottom: 0.5rem;
    }

    .hero-title span {
      color: var(--accent-blue);
      text-shadow: 0 0 20px rgba(0, 240, 255, 0.4);
    }

    .hero-subtitle {
      color: var(--text-muted);
      font-size: 1.1rem;
      margin-bottom: 2.5rem;
    }

    .search-box {
      position: relative;
      width: 100%;
      max-width: 650px;
      display: flex;
      align-items: center;
    }

    .search-box input {
      width: 100%;
      padding: 1.25rem 1.5rem;
      padding-right: 3.5rem;
      border-radius: 99px;
      background: rgba(15, 23, 42, 0.8);
      border: 1px solid rgba(0, 240, 255, 0.2);
      color: #fff;
      font-size: 1rem;
      outline: none;
      transition: all 0.3s ease;
      box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
    }

    .search-box input:focus {
      border-color: var(--accent-blue);
      box-shadow: 0 0 25px rgba(0, 240, 255, 0.25);
    }

    .search-box button {
      position: absolute;
      right: 8px;
      background: linear-gradient(135deg, var(--accent-blue), var(--accent-indigo));
      border: none;
      width: 46px;
      height: 46px;
      border-radius: 50%;
      color: #000;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: transform 0.2s ease;
    }

    .search-box button:hover {
      transform: scale(1.05);
    }

    /* Cartes & En-tête des paroles */
    .glass-card {
      background: var(--card-bg);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      padding: 2rem;
      margin-bottom: 1.5rem;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    }

    /* Modificateurs Responsive */
    @media (max-width: 768px) {
      .hero-title { font-size: 2.2rem; }
      .container { padding: 1rem; }
    }
  </style>

  <link rel="stylesheet" href="css/style.css" media="print" onload="this.media='all'">
</head>
<body>

  <!-- Fonds avec effet de lueur Néon Bleu/Noir -->
  <div class="ambient-glow glow-1"></div>
  <div class="ambient-glow glow-2"></div>
  <div class="ambient-glow glow-3"></div>

  <!-- En-tête principal -->
  <header class="navbar">
    <div class="logo-brand" id="homeBtn" role="button" tabindex="0" aria-label="Retour à l'accueil">
      <div class="logo-svg-wrapper">
        <!-- SVG Optimisé : Logo en "C" fluide & moderne -->
        <svg viewBox="0 0 500 500" class="sl-logo-svg" width="100%" height="100%" aria-hidden="true">
          <defs>
            <filter id="glow-effect" x="-20%" y="-20%" width="140%" height="140%">
              <feGaussianBlur stdDeviation="12" result="blur" />
              <feMerge>
                <feMergeNode in="blur" />
                <feMergeNode in="SourceGraphic" />
              </feMerge>
            </filter>
            <linearGradient id="neon-blue-grad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#00f0ff" />
              <stop offset="50%" stop-color="#3b82f6" />
              <stop offset="100%" stop-color="#030712" />
            </linearGradient>
          </defs>

          <!-- Anneau extérieur -->
          <circle cx="250" cy="250" r="210" fill="none" stroke="url(#neon-blue-grad)" stroke-width="10" filter="url(#glow-effect)" opacity="0.8" />
          
          <!-- Monogramme "C" artistique -->
          <path d="M 330 160 C 270 100, 160 110, 120 210 C 80 310, 160 400, 310 380 C 350 375, 370 350, 380 335 L 320 315 C 300 325, 255 330, 215 310 C 165 285, 160 215, 195 175 C 225 145, 290 145, 320 175 Z" 
                fill="url(#neon-blue-grad)" 
                filter="url(#glow-effect)" />
        </svg>
      </div>
      <div class="brand-text">
        <span class="brand-title">SHADE</span>
        <span class="brand-subtitle">LYRICS</span>
      </div>
    </div>
  </header>

  <!-- Conteneur Applicatif -->
  <main class="container">
    
    <!-- Hero / Module de recherche -->
    <section class="hero-section" id="heroSection">
      <h1 class="hero-title">SHADE <span>LYRICS</span></h1>
      <p class="hero-subtitle">Recherchez. Écoutez. Lisez vos paroles instantanément.</p>
      
      <form class="search-box" id="searchForm" action="#" onsubmit="return false;">
        <input type="text" id="searchInput" placeholder="Rechercher une chanson, un artiste..." autocomplete="off" required>
        <button id="searchBtn" type="submit" aria-label="Rechercher">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
          </svg>
        </button>
      </form>
    </section>

    <!-- Section Résultats de recherche -->
    <section class="results-section hidden" id="resultsSection" aria-live="polite">
      <h2 class="section-title">Résultats</h2>
      <div class="results-grid" id="resultsGrid"></div>
    </section>

    <!-- Section Affichage des Paroles -->
    <section class="lyrics-section hidden" id="lyricsSection">
      <button class="back-btn" id="backBtn" aria-label="Retourner aux résultats">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Retour
      </button>
      
      <article class="lyrics-header glass-card">
        <img id="songCover" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E" alt="Pochette de l'album" class="song-cover" width="120" height="120" loading="lazy">
        <div class="song-details">
          <h2 id="songTitle" class="song-title">---</h2>
          <p id="songArtist" class="song-artist">---</p>
          <p id="songAlbum" class="song-album">---</p>
          <div class="action-buttons">
            <button class="btn-action" id="focusBtn">Focus Mode</button>
            <button class="btn-action" id="copyBtn">Copier</button>
            <button class="btn-action" id="shareBtn">Partager</button>
          </div>
        </div>
      </article>

      <!-- Lecteur Audio Ultra-Rapide -->
      <div id="playerContainer" class="player-card glass-card hidden">
        <div class="player-info">
          <button id="playPauseBtn" class="play-btn" aria-label="Lecture">▶</button>
          <div class="progress-bar-container" id="progressContainer">
            <div class="progress-bar" id="progressBar"></div>
          </div>
          <span id="timeDisplay" class="time-display">0:00</span>
        </div>
        <audio id="audioElement" preload="none"></audio>
      </div>

      <!-- Corps des paroles -->
      <div class="lyrics-body glass-card" id="lyricsBody">
        <pre id="lyricsText"></pre>
      </div>
    </section>

  </main>

  <!-- Chargement Asynchrone des scripts pour ne pas bloquer le fil principal -->
  <script src="js/player.js" defer></script>
  <script src="js/app.js" defer></script>

</body>
</html>
