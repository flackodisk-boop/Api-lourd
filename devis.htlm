<!DOCTYPE html>
<html lang="fr" class="h-full bg-slate-50">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Devis - JPP Plomberie</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
</head>
<body class="h-full flex flex-col md:flex-row">

  <aside class="w-full md:w-64 bg-slate-900 text-slate-300 flex flex-col justify-between p-4">
    <div class="space-y-6">
      <div class="flex items-center gap-3 p-2">
        <div class="w-10 h-10 rounded-xl bg-red-600 flex items-center justify-center text-white text-2xl font-black">J</div>
        <div>
          <h1 class="font-bold text-white leading-tight">JPP Plomberie</h1>
          <p class="text-xs text-emerald-400">● En ligne</p>
        </div>
      </div>
      <nav class="space-y-1">
        <a href="dashboard.html" class="flex items-center gap-3 px-4 py-3 hover:bg-slate-800 rounded-xl text-sm font-medium"><i class="fa-solid fa-chart-pie w-5"></i> Dashboard</a>
        <a href="clients.html" class="flex items-center gap-3 px-4 py-3 hover:bg-slate-800 rounded-xl text-sm font-medium"><i class="fa-solid fa-users w-5"></i> Clients</a>
        <a href="interventions.html" class="flex items-center gap-3 px-4 py-3 hover:bg-slate-800 rounded-xl text-sm font-medium"><i class="fa-solid fa-clipboard-list w-5"></i> Interventions</a>
        <a href="devis.html" class="flex items-center gap-3 px-4 py-3 bg-blue-600 text-white rounded-xl text-sm font-medium"><i class="fa-solid fa-file-invoice-dollar w-5"></i> Devis</a>
        <a href="stock.html" class="flex items-center gap-3 px-4 py-3 hover:bg-slate-800 rounded-xl text-sm font-medium"><i class="fa-solid fa-boxes-stacked w-5"></i> Stock</a>
      </nav>
    </div>
    <button onclick="logout()" class="w-full flex items-center justify-center gap-2 px-4 py-2.5 text-xs font-semibold rounded-xl text-slate-400 hover:bg-slate-800 hover:text-rose-400 transition">
      <i class="fa-solid fa-right-from-bracket"></i> Déconnexion
    </button>
  </aside>

  <main class="flex-1 p-8 overflow-y-auto space-y-6">
    <h2 class="text-2xl font-bold text-slate-900">Générer Devis / Facture</h2>

    <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm">
      <form onsubmit="generateDoc(event)" class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <select id="devis-client" class="px-4 py-2.5 rounded-xl border text-sm" required></select>
        <input type="text" id="devis-service" placeholder="Prestation" class="px-4 py-2.5 rounded-xl border text-sm" required>
        <input type="number" step="0.01" id="devis-montant" placeholder="Montant HT (€)" class="px-4 py-2.5 rounded-xl border text-sm" required>
        <button type="submit" class="bg-blue-600 text-white py-2.5 rounded-xl text-sm font-semibold hover:bg-blue-700">Créer</button>
      </form>
    </div>

    <div id="preview" class="hidden bg-white p-8 rounded-2xl border border-slate-200 shadow-xl max-w-2xl mx-auto space-y-6">
      <div class="flex justify-between items-center border-b pb-4">
        <h3 class="text-xl font-bold text-slate-900">JPP Plomberie</h3>
        <span class="text-lg font-black text-blue-600">DEVIS</span>
      </div>
      <p id="doc-client" class="text-sm font-medium text-slate-700"></p>
      <div class="flex justify-between text-sm py-2 border-y">
        <span id="doc-service"></span>
        <span id="doc-ht" class="font-bold"></span>
      </div>
      <button onclick="html2pdf().from(document.getElementById('preview')).save()" class="w-full bg-slate-900 text-white py-2.5 rounded-xl text-xs font-bold">Télécharger PDF</button>
    </div>
  </main>

  <script src="js/app.js"></script>
  <script src="js/auth.js"></script>
  <script>
    requireAuth();
    document.addEventListener('DOMContentLoaded', () => {
      const db = getDB();
      const select = document.getElementById('devis-client');
      select.innerHTML = '';
      db.clients.forEach(c => select.innerHTML += `<option value="${c.id}">${c.nom}</option>`);
    });

    function generateDoc(e) {
      e.preventDefault();
      const db = getDB();
      const client = db.clients.find(c => c.id == document.getElementById('devis-client').value);
      
      document.getElementById('doc-client').innerText = `Client : ${client.nom} - ${client.tel}`;
      document.getElementById('doc-service').innerText = document.getElementById('devis-service').value;
      document.getElementById('doc-ht').innerText = parseFloat(document.getElementById('devis-montant').value).toFixed(2) + " €";
      document.getElementById('preview').classList.remove('hidden');
    }
  </script>
</body>
</
  html>
