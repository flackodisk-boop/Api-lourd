<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Inscription - JPP Plomberie</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="css/style.css">
</head>
<body class="bg-slate-900 min-h-screen flex items-center justify-center p-4">

  <div class="bg-white p-8 rounded-2xl shadow-2xl w-full max-w-sm space-y-6">
    <div class="text-center space-y-2">
      <div class="w-12 h-12 rounded-2xl bg-red-600 flex items-center justify-center text-white text-3xl font-black mx-auto shadow-lg shadow-red-600/30">
        J
      </div>
      <h2 class="text-2xl font-bold text-slate-900">Créer un compte</h2>
      <p class="text-xs text-slate-500">Inscrivez-vous pour accéder à l'application</p>
    </div>

    <form onsubmit="handleRegister(event)" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold text-slate-600 mb-1">Nom complet</label>
        <input id="reg-name" type="text" placeholder="Jean Dupont" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" required>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-600 mb-1">Identifiant</label>
        <input id="reg-user" type="text" placeholder="jdupont" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" required>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-600 mb-1">Mot de passe</label>
        <input id="reg-pass" type="password" placeholder="••••••••" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" required>
      </div>

      <button type="submit" class="w-full py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl text-sm shadow-lg shadow-blue-600/30 transition">
        S'inscrire
      </button>
    </form>

    <div class="text-center text-xs">
      <a href="login.html" class="text-blue-600 hover:underline">Déjà un compte ? Se connecter</a>
    </div>
  </div>

  <script src="js/app.js"></script>
  <script src="js/auth.js"></script>
  <script>
    function handleRegister(e) {
      e.preventDefault();
      const db = getDB();
      const newUser = {
        id: Date.now(),
        nom: document.getElementById('reg-name').value.trim(),
        user: document.getElementById('reg-user').value.trim().toLowerCase(),
        pass: document.getElementById('reg-pass').value.trim()
      };
      
      db.users.push(newUser);
      saveDB(db);

      alert("✅ Compte créé avec succès ! Connectez-vous.");
      window.location.href = 'login.html';
    }
  </script>
</body>

  </html>
