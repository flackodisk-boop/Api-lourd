<!doctype html>
<html lang="fr"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Neo — l'IA de Célestin Olua</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E🟣%3C/text%3E%3C/svg%3E">
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800&display=swap" rel="stylesheet">
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
--bg:#f3f4ff;--panel:rgba(255,255,255,.74);--solid:#fff;--core:#fff;--text:#14182e;--sub:#5d6788;--bd:rgba(30,40,90,.12);--code:#eef1fb;--sh:rgba(70,60,160,.2);
--c1:#ff2e93;--c2:#7c4dff;--c3:#00b8e6;--c4:#00c98d;--c5:#f5a800}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#070a1a;--panel:rgba(22,28,62,.62);--solid:#141935;--core:#070a1a;--text:#eef1ff;--sub:#9aa6c7;--bd:rgba(255,255,255,.12);--code:#0b0f26;--sh:rgba(0,0,0,.5);--c3:#00d4ff;--c4:#00ffb3;--c5:#ffcc33}}
:root[data-theme="dark"]{--bg:#070a1a;--panel:rgba(22,28,62,.62);--solid:#141935;--core:#070a1a;--text:#eef1ff;--sub:#9aa6c7;--bd:rgba(255,255,255,.12);--code:#0b0f26;--sh:rgba(0,0,0,.5);--c3:#00d4ff;--c4:#00ffb3;--c5:#ffcc33}
*{box-sizing:border-box}[hidden]{display:none!important}
html,body{height:100%;margin:0}
body{background:var(--bg);color:var(--text);font:16px/1.55 Outfit,system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;display:flex;flex-direction:column;overflow:hidden}
.aur{position:fixed;inset:0;overflow:hidden;pointer-events:none;z-index:0}
.aur i{position:absolute;width:60vmax;height:60vmax;border-radius:50%;filter:blur(80px);opacity:.34;animation:dr 20s ease-in-out infinite alternate}
.aur i:nth-child(1){background:var(--c1);left:-20vmax;top:-20vmax}.aur i:nth-child(2){background:var(--c3);right:-25vmax;top:10vmax;animation-delay:-7s}.aur i:nth-child(3){background:var(--c2);left:5vmax;bottom:-30vmax;animation-delay:-13s}
@keyframes dr{to{transform:translate(8vmax,6vmax) scale(1.15)}}@keyframes sp{to{transform:rotate(360deg)}}@keyframes fl{to{background-position:300% 0}}@keyframes up{from{opacity:0;transform:translateY(12px) scale(.98)}}@keyframes bo{40%{transform:translateY(-5px);opacity:1}}@keyframes pu{50%{box-shadow:0 0 0 8px transparent}}
header,#chat,#bar{position:relative;z-index:1}
header{display:flex;align-items:center;gap:12px;padding:12px 16px;background:var(--panel);backdrop-filter:blur(16px)}
header::after{content:"";position:absolute;left:0;right:0;bottom:0;height:3px;background:linear-gradient(90deg,#007fff,#f7d618,#ce1021,var(--c1),var(--c2),var(--c3),#007fff);background-size:300% 100%;animation:fl 6s linear infinite}
.orb{position:relative;width:44px;height:44px;border-radius:50%;display:grid;place-items:center;flex:none}
.orb::before{content:"";position:absolute;inset:0;border-radius:50%;background:conic-gradient(#007fff,#f7d618,#ce1021,var(--c1),var(--c2),var(--c3),#007fff);animation:sp 4s linear infinite;box-shadow:0 0 22px color-mix(in srgb,var(--c2) 60%,transparent)}
.orb::after{content:"";position:absolute;inset:3px;border-radius:50%;background:var(--core)}
.orb i{position:relative;z-index:1;font-style:normal;font-weight:800;font-size:21px;background:linear-gradient(135deg,var(--c3),var(--c1));-webkit-background-clip:text;background-clip:text;color:transparent}
.orb s{position:absolute;top:-4px;right:-3px;z-index:2;color:#f7d618;font-size:14px;text-decoration:none;text-shadow:0 0 8px #f7d618}
.t{flex:1;min-width:0}.t b{font-size:19px;font-weight:800;display:block;background:linear-gradient(90deg,var(--c1),var(--c2),var(--c3));-webkit-background-clip:text;background-clip:text;color:transparent}.t span{font-size:12.5px;color:var(--sub)}
.ib{border:1px solid var(--bd);background:var(--panel);backdrop-filter:blur(10px);color:var(--text);border-radius:12px;padding:8px 12px;font:inherit;font-size:14px;cursor:pointer}
#chat{flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:14px;scroll-behavior:smooth}
.m{display:flex;gap:8px;animation:up .4s cubic-bezier(.2,.8,.2,1) both}.m.u{justify-content:flex-end}
.col{display:flex;flex-direction:column;align-items:flex-start;max-width:88%;min-width:0}.u .col{align-items:flex-end}
.av{width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,var(--c1),var(--c2),var(--c3));color:#fff;font-weight:800;font-size:15px;display:grid;place-items:center;flex:none;margin-top:2px;box-shadow:0 4px 14px color-mix(in srgb,var(--c2) 50%,transparent)}
.bb{padding:11px 15px;border-radius:20px;overflow-wrap:anywhere;max-width:100%}
.u .bb{background:linear-gradient(135deg,var(--c1),var(--c2));color:#fff;border-bottom-right-radius:6px;white-space:pre-wrap;box-shadow:0 8px 26px color-mix(in srgb,var(--c1) 38%,transparent)}
.b .bb{background:var(--panel);backdrop-filter:blur(14px);border:1px solid var(--bd);box-shadow:inset 3px 0 0 var(--c3),0 8px 30px var(--sh);border-bottom-left-radius:6px}
.gi{max-width:100%;width:100%;border-radius:14px;display:block;margin-bottom:6px;cursor:zoom-in}.u .gi{width:auto;max-height:230px}
.cap{font-size:13px;color:var(--sub)}.row{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
.dl,.sp{border:1px solid var(--bd);background:color-mix(in srgb,var(--c3) 12%,transparent);color:var(--text);font:inherit;font-size:13px;border-radius:999px;padding:5px 12px;cursor:pointer;margin-top:5px}
.dl:active,.sp:active{transform:scale(.95)}
.pg{display:grid;grid-template-columns:1fr 1fr;gap:8px;width:100%;min-width:230px}.pt{position:relative}.pt img{width:100%;aspect-ratio:3/4;object-fit:cover;border-radius:14px;display:block;cursor:zoom-in;background:var(--code)}
.pt button{position:absolute;right:6px;bottom:6px;border:0;border-radius:50%;width:32px;height:32px;background:rgba(0,0,0,.6);color:#fff;font-size:15px;cursor:pointer}
pre{background:var(--code);border:1px solid var(--bd);border-radius:12px;padding:10px;overflow-x:auto;font-size:13.5px;margin:8px 0}
code{font-family:ui-monospace,Consolas,monospace;font-size:.92em}p code,.bb>code{background:var(--code);padding:1px 5px;border-radius:6px}
.hero{margin:auto;text-align:center;max-width:500px;padding:10px;animation:up .6s both}
.hero .orb{width:92px;height:92px;margin:0 auto 16px}.hero .orb i{font-size:44px}.hero .orb s{font-size:24px}
.hero h1{margin:0 0 8px;font-size:30px;font-weight:800;background:linear-gradient(90deg,var(--c1),var(--c2),var(--c3),var(--c4));background-size:200% 100%;animation:fl 8s linear infinite;-webkit-background-clip:text;background-clip:text;color:transparent}
.hero p{margin:0 0 20px;color:var(--sub)}
.chips{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.chip{display:flex;align-items:center;gap:10px;text-align:left;border:1px solid var(--bd);background:var(--panel);backdrop-filter:blur(12px);color:var(--text);border-radius:16px;padding:12px;font:inherit;font-size:14px;cursor:pointer;box-shadow:0 6px 20px var(--sh);transition:transform .15s}
.chip span{font-size:22px;filter:drop-shadow(0 0 8px var(--k))}.chip:hover{transform:translateY(-2px)}.chip:active{transform:scale(.97)}
.chip:nth-child(1){--k:var(--c1)}.chip:nth-child(2){--k:var(--c2)}.chip:nth-child(3){--k:var(--c3)}.chip:nth-child(4){--k:var(--c4)}
#bar{padding:6px 0 0;background:linear-gradient(transparent,color-mix(in srgb,var(--bg) 80%,transparent) 40%)}
#tl{display:flex;gap:8px;overflow-x:auto;padding:4px 14px}
.tool{border:1.5px solid var(--k);background:var(--panel);backdrop-filter:blur(10px);color:var(--text);border-radius:999px;padding:6px 12px;font:inherit;font-size:13px;cursor:pointer;white-space:nowrap}
.tool:nth-child(1){--k:var(--c1)}.tool:nth-child(2){--k:var(--c2)}.tool:nth-child(3){--k:var(--c3)}.tool:nth-child(4){--k:var(--c4)}.tool:nth-child(5){--k:var(--c5)}.tool:active{transform:scale(.95)}
#pv{display:flex;align-items:center;gap:8px;padding:6px 14px 0}#pv img{height:50px;border-radius:10px;border:2px solid var(--c2)}
form{display:flex;gap:8px;padding:6px 12px 12px}
textarea{flex:1;resize:none;max-height:140px;border:1.5px solid var(--bd);background:var(--panel);backdrop-filter:blur(14px);color:var(--text);border-radius:22px;padding:12px 16px;font:inherit;outline:none;box-shadow:0 6px 24px var(--sh)}textarea:focus{border-color:var(--c2)}
#go{width:48px;height:48px;border:0;border-radius:50%;background:linear-gradient(135deg,var(--c1),var(--c2),var(--c3));color:#fff;font-size:20px;cursor:pointer;flex:none;align-self:flex-end;box-shadow:0 6px 22px color-mix(in srgb,var(--c2) 55%,transparent);animation:pu 2.4s infinite}
.ty{display:inline-flex;align-items:center;gap:5px}.ty b{width:7px;height:7px;border-radius:50%;background:var(--c3);opacity:.4;animation:bo 1s infinite}.ty b:nth-child(2){animation-delay:.15s;background:var(--c2)}.ty b:nth-child(3){animation-delay:.3s;background:var(--c1)}.ty em{font-style:normal;color:var(--sub);margin-left:4px;font-size:14px}
#lb{position:fixed;inset:0;z-index:50;background:rgba(5,8,20,.9);backdrop-filter:blur(6px);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;padding:16px}
#lb img{max-width:100%;max-height:76vh;border-radius:16px;box-shadow:0 20px 60px #000}#lb .row{margin:0}#lb .dl{color:#fff;font-size:15px;padding:9px 18px}
#me{width:38px;height:38px;border-radius:50%;padding:0;overflow:hidden;font-weight:800;display:grid;place-items:center;background:linear-gradient(135deg,var(--c1),var(--c2));color:#fff;border:2px solid var(--c3)}#me img{width:100%;height:100%;object-fit:cover}
#mp{position:fixed;right:12px;top:calc(env(safe-area-inset-top,0px) + 62px);z-index:40;background:var(--solid);border:1px solid var(--bd);border-radius:16px;padding:14px;box-shadow:0 14px 40px var(--sh);display:flex;flex-direction:column;gap:10px;max-width:260px;font-size:14px}#mpt{white-space:pre-line;overflow-wrap:anywhere;color:var(--sub)}
#auth{position:fixed;inset:0;z-index:60;display:grid;place-items:center;padding:16px;background:rgba(5,8,20,.55);backdrop-filter:blur(14px);overflow-y:auto}
.ac{width:100%;max-width:390px;background:var(--solid);border:1px solid var(--bd);border-radius:26px;padding:26px 22px;text-align:center;box-shadow:0 24px 70px var(--sh);animation:up .5s both;display:flex;flex-direction:column;gap:10px}
.ac .orb{margin:0 auto 4px;width:68px;height:68px}.ac .orb i{font-size:32px}.ac h2{margin:0;font-size:24px;font-weight:800;background:linear-gradient(90deg,var(--c1),var(--c2),var(--c3));-webkit-background-clip:text;background-clip:text;color:transparent}.ac p{margin:0 0 4px;color:var(--sub);font-size:14px}
.ac input{border:1.5px solid var(--bd);background:var(--bg);color:var(--text);border-radius:14px;padding:12px 14px;font:inherit;outline:none;width:100%}.ac input:focus{border-color:var(--c2)}
.gbtn{display:flex;align-items:center;justify-content:center;gap:10px;background:#fff;color:#222;border:1px solid #dadce0;border-radius:14px;padding:12px;font:inherit;font-weight:600;cursor:pointer}
.or{color:var(--sub);font-size:13px}#ae{min-height:18px;font-size:13px;color:var(--c1)}.row2{display:flex;gap:8px}.row2 button{flex:1;border-radius:14px;padding:12px;font:inherit;font-weight:600;cursor:pointer}
.pri{border:0;background:linear-gradient(135deg,var(--c1),var(--c2),var(--c3));color:#fff}.sec{border:1.5px solid var(--c2);background:none;color:var(--text)}
.lnk{border:0;background:none;color:var(--c3);font:inherit;font-size:14px;cursor:pointer;padding:4px}
</style></head>
<body>
<div class="aur"><i></i><i></i><i></i></div>
<header>
  <div class="orb"><i>N</i><s>★</s></div>
  <div class="t"><b>Neo</b><span>Créée par Célestin Olua 🇨🇩 RDC</span></div>
  <button class="ib" id="me" hidden title="Mon compte"></button>
  <button class="ib" id="th" title="Thème">🌓</button>
  <button class="ib" id="nw">+ Nouveau</button>
</header>
<div id="chat"></div>
<div id="bar">
  <div id="pv" hidden><img alt=""><button class="ib" id="px">✕</button></div>
  <div id="tl">
    <label class="tool" id="cam" hidden>📷 Vision<input type="file" id="fi" hidden></label>
    <button class="tool" data-p="imagine ">🎨 Imagine</button>
    <button class="tool" data-p="carte ">🗺️ Carte</button>
    <button class="tool" data-p="say ">🎙️ Voix</button>
    <button class="tool" data-p="pin " id="pinb">📌 Pin</button>
  </div>
  <form id="f"><textarea id="in" rows="1" placeholder="Écris à Neo…" enterkeyhint="send"></textarea><button id="go" type="submit">➤</button></form>
</div>
<div id="mp" hidden><div id="mpt"></div><button class="ib" id="out">Se déconnecter</button></div>
<div id="auth" hidden><div class="ac"><div class="orb"><i>N</i><s>★</s></div><h2>Bienvenue sur Neo</h2><p>Connecte-toi pour sauvegarder tes discussions sur tous tes appareils.</p>
<button class="gbtn" id="agoo"><svg width="18" height="18" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.8 2.4 30.3 0 24 0 14.6 0 6.5 5.4 2.6 13.2l7.9 6.1C12.4 13.6 17.7 9.5 24 9.5z"/><path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.7c-.6 3-2.3 5.5-4.8 7.2l7.5 5.8c4.4-4.1 7.1-10.1 7.1-17.5z"/><path fill="#FBBC05" d="M10.5 28.7c-.5-1.5-.8-3-.8-4.7s.3-3.2.8-4.7l-7.9-6.1C.9 16.4 0 20.1 0 24s.9 7.6 2.6 10.8l7.9-6.1z"/><path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.5-5.8c-2.1 1.4-4.8 2.3-8.4 2.3-6.3 0-11.6-4.1-13.5-9.8l-7.9 6.1C6.5 42.6 14.6 48 24 48z"/></svg>Continuer avec Google</button>
<div class="or">ou avec ton email</div>
<input id="anm" placeholder="Ton prénom (pour créer un compte)" autocomplete="given-name"><input id="aem" type="email" placeholder="Email" autocomplete="email"><input id="apw" type="password" placeholder="Mot de passe (6 caractères min)" autocomplete="current-password">
<div id="ae"></div><div class="row2"><button class="pri" id="alog">Se connecter</button><button class="sec" id="areg">Créer un compte</button></div>
<button class="lnk" id="afor">Mot de passe oublié ?</button><button class="lnk" id="agst">Continuer sans compte</button></div></div>
<div id="lb" hidden><img alt=""><div class="row"><button class="dl" id="lbd">⬇ Télécharger</button><button class="dl" id="lbx">✕ Fermer</button></div></div>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>
<script>
/* ===== CONFIG : fichier unique, aucun serveur à ajouter ===== */
const CFG={
  AI:"https://shizuai.vercel.app/chat", // API IA (POST {uid,message,image_url} → {reply})
  IMG:"https://dall-e-tau-steel.vercel.app/kshitiz",
  PIN:"https://zetbot-page.onrender.com/api/pinterest",
  VIS:"https://vision-api-opyw.onrender.com/describe",
  PROXY:"", // optionnel : si une API bloque le navigateur (CORS), mets l'URL d'un proxy ici
  FIREBASE:{apiKey:"",authDomain:"",projectId:"",appId:""} // ← colle ici la config Firebase de ton projet (comptes + Google)
};
const SYS="Tu es Neo, une IA créée par Célestin Olua, de la RDC (République démocratique du Congo). Réponds en français par défaut, ou dans la langue de l'utilisateur. Ton style : cool, chaleureux, direct et utile, avec un peu d'humour et des emojis. Si on te demande qui t'a créé, réponds fièrement : Célestin Olua, de la RDC. Tu es une IA : ne prétends jamais être humain. N'écris aucun lien web. Réponses claires et courtes quand c'est possible ; le code va dans des blocs ```.\nActions : termine ta réponse par UN seul déclencheur quand c'est utile : IMAGINE_TRIGGER: <description détaillée> (créer une image), MAP_TRIGGER: <lieu> (carte), AUDIO_TRIGGER: <texte court> (lire à voix haute), VISION_TRIGGER: <question> (analyser l'image jointe), PIN_TRIGGER: <mot-clé> (recherche Pinterest).";
const TRG=/(VISION|IMAGINE|PIN|MAP|AUDIO)_TRIGGER:\s*/;
const SUGG=[["💬","Qui t'a créé ?"],["🎨","imagine un lion cyberpunk à Kinshasa"],["🗺️","carte Kinshasa"],["🎙️","say Bonjour, je suis Neo"]];
const APILIM={maxInputBytes:15e6,mediaTypes:["image/jpeg","image/png","image/webp","image/gif"]};
const $=s=>document.querySelector(s),chat=$("#chat"),inp=$("#in"),go=$("#go");
let mem={name:null,hist:[]},smp=null,lim=null,ctl=null,busy=false,pend=null,pins=null;
const FB=(CFG.FIREBASE.apiKey&&window.firebase)?(firebase.initializeApp(CFG.FIREBASE),{a:firebase.auth(),d:firebase.firestore()}):null;let user=null;
let MK="neo_m";const loadLocal=()=>{mem={name:null,hist:[]};try{const m=JSON.parse(localStorage.getItem(MK)||"{}");mem.name=m.name||null;mem.hist=(m.hist||[]).filter(h=>Date.now()-h.t<30*864e5)}catch(e){}};loadLocal();
try{const t=localStorage.getItem("neo_t");if(t)document.documentElement.dataset.theme=t}catch(e){}
let cloudT;const save0=()=>{try{mem.hist=mem.hist.slice(-80);localStorage.setItem(MK,JSON.stringify(mem))}catch(e){}if(FB&&user){clearTimeout(cloudT);cloudT=setTimeout(()=>FB.d.doc("users/"+user.uid).set({name:mem.name||null,hist:mem.hist,updated:Date.now()},{merge:true}).catch(()=>{}),1500)}};
const pushH=(role,content)=>{mem.hist.push({role,content,t:Date.now()});save0()};
const esc=s=>s.replace(/[&<>]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;"}[c]));
const md=t=>esc(t).split("```").map((s,i)=>i%2?"<pre><code>"+s.replace(/^[\w+-]*\n/,"")+"</code></pre>":s.replace(/`([^`\n]+)`/g,"<code>$1</code>").replace(/\*\*([^*]+)\*\*/g,"<b>$1</b>").replace(/\n/g,"<br>")).join("");
const typing=t=>'<span class="ty"><b></b><b></b><b></b><em>'+esc(t||"Neo réfléchit")+'</em></span>';
const down=()=>{chat.scrollTop=chat.scrollHeight};
/* ===== réseau ===== */
const via=u=>CFG.PROXY+encodeURIComponent(u),viaImg=u=>CFG.PROXY+encodeURIComponent(u)+"&img=1";
async function net(u,o,img){for(const f of CFG.PROXY?[img?viaImg:via,x=>x]:[x=>x]){try{const r=await fetch(f(u),o);if(r.ok)return r}catch(e){}}throw{code:"net"}}
async function jget(u){const t=await(await net(u)).text();try{return JSON.parse(t)}catch(e){return t}}
const blobOf=async u=>(await net(u,{},true)).blob();
const dlUrl=async(u,n)=>{try{save(await blobOf(u),n)}catch(e){window.open(u,"_blank")}};
const pickText=d=>typeof d=="string"?d:(d&&(d.message||d.reply||d.result||d.answer||d.response))||"";
/* ===== téléchargement ===== */
async function save(blob,name){
  try{const d=window.claude&&claude.use?await claude.use("downloads"):null;if(d){try{await d.save({filename:name,data:blob})}catch(e){}return}}catch(e){}
  const a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download=name;document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(a.href),4e3)}
const svgToPng=svg=>new Promise((ok,ko)=>{const i=new Image();i.onload=()=>{const c=document.createElement("canvas");c.width=1600;c.height=1200;c.getContext("2d").drawImage(i,0,0,1600,1200);c.toBlob(b=>b?ok(b):ko(),"image/png")};i.onerror=ko;i.src="data:image/svg+xml;charset=utf-8,"+encodeURIComponent(svg)});
function btn(p,label,fn,cls){const b=document.createElement("button");b.className=cls||"dl";b.textContent=label;b.onclick=fn;p.append(b);return b}
function lb(src,get,name){$("#lb img").src=src;$("#lb").hidden=false;$("#lbd").onclick=async()=>{let b=null;try{b=await get()}catch(e){}b?save(b,name):window.open(src,"_blank")}}
$("#lbx").onclick=()=>{$("#lb").hidden=true};$("#lb").onclick=e=>{if(e.target.id=="lb")$("#lb").hidden=true};
/* ===== voix ===== */
function speak(t){if(!window.speechSynthesis)return false;speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(String(t).slice(0,500));u.lang="fr-FR";speechSynthesis.speak(u);return true}
/* ===== affichage ===== */
function add(role,text){
  const m=document.createElement("div");m.className="m "+(role=="user"?"u":"b");
  const col=document.createElement("div"),b=document.createElement("div");col.className="col";b.className="bb";
  if(role=="user")b.textContent=text;else{b.innerHTML=md(text);const a=document.createElement("div");a.className="av";a.textContent="N";m.append(a)}
  col.append(b);m.append(col);chat.append(m);down();return b}
function acts(b,t){if(!window.speechSynthesis||!t)return;btn(b.parentNode,"🔊 Écouter",()=>speak(t),"sp")}
function say(b,t){b.innerHTML=md(t);acts(b,t);down()}
function hero(){
  chat.innerHTML='<div class="hero"><div class="orb"><i>N</i><s>★</s></div><h1>Salut'+(mem.name?" "+esc(mem.name):"")+', moi c\'est Neo 👋</h1><p>Une IA créée par Célestin Olua, de la RDC 🇨🇩. Discute, crée des images, télécharge-les, analyse tes photos.</p><div class="chips"></div></div>';
  const c=chat.querySelector(".chips");SUGG.forEach(([i,s])=>{const k=document.createElement("button");k.className="chip";k.innerHTML="<span>"+i+"</span>";k.append(s);k.onclick=()=>send(s);c.append(k)})}
function draw(){chat.innerHTML="";if(!mem.hist.length)return hero();mem.hist.forEach(h=>{const b=add(h.role,h.content);if(h.role!="user")acts(b,h.content)})}
function setBusy(v){busy=v;go.textContent=v?"■":"➤"}
const imgLim=()=>smp?(lim&&lim.images):APILIM;
function setPend(f){
  if(!f)return;const L=imgLim();
  if(!L||f.size>L.maxInputBytes||!L.mediaTypes.includes(f.type)){add("assistant","⚠️ Image non acceptée (type ou taille).");return}
  pend=f;$("#pv img").src=URL.createObjectURL(f);$("#pv").hidden=false}
function clearPend(){pend=null;$("#pv").hidden=true;$("#fi").value=""}
const ERR={cancelled:"⏹️ Arrêté.",not_granted:"🔒 Autorise l'accès à Claude quand la fenêtre apparaît, puis réessaie.",rate_limited:"⏳ Trop de demandes, attends un instant.",none:"Neo n'est pas disponible ici : ouvre cette page depuis claude.ai.",bad:"😕 Je n'ai pas réussi à créer ça, reformule ta demande.",net:"🌐 Service momentanément indisponible, réessaie dans un instant."};
/* ===== IA ===== */
async function ai(turns,onText){
  const prof="[Profil] Nom : "+(mem.name||"inconnu")+" | Heure à Kinshasa : "+new Date().toLocaleString("fr-FR",{timeZone:"Africa/Kinshasa"});
  if(smp){const t=turns.map(x=>({...x}));t[0].content="[Consignes]\n"+SYS+"\n"+prof+"\n\n[Conversation]\n"+t[0].content;return(await smp(t,{cache:false,signal:ctl.signal,onText})).text}
  const fresh=turns.length<2||!mem.sid;if(fresh)mem.sid="neo_"+Math.random().toString(36).slice(2,12)+Date.now().toString(36);
  const cur=turns[turns.length-1].content,msg=fresh?SYS+"\n"+prof+"\n\nMessage de l'utilisateur :\n"+cur:cur;
  const r=await net(CFG.AI,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({uid:mem.sid,message:msg,image_url:null}),signal:ctl&&ctl.signal});
  const d=await r.json().catch(()=>null);
  const t=pickText(d).replace(/Shizuka? AI|Shizu|Christus( AI)?|Heck\.ai|Aryan/gi,"Neo").replace(/https?:\/\/\S+/g,"").trim()||"Je suis là, dis-moi tout ! 😊";
  onText&&onText({text:t});return t}
async function chatAI(b,file){
  const turns=[];mem.hist.slice(-15).forEach(h=>{const l=turns[turns.length-1];if(l&&l.role==h.role)l.content+="\n"+h.content;else turns.push({role:h.role,content:h.content})});
  while(turns.length&&turns[0].role!="user")turns.shift();
  let part="";
  try{part=await ai(turns,({text})=>{part=text;b.innerHTML=md(text.split(TRG)[0])||typing("…");down()})||part}
  catch(e){e.text=e.text||part;throw e}
  const tm=part.match(/(VISION|IMAGINE|PIN|MAP|AUDIO)_TRIGGER:\s*([\s\S]*)/),before=(tm?part.slice(0,tm.index):part).trim();
  if(before){say(b,before);pushH("assistant",before)}else b.closest(".m").remove();
  if(tm)await act(tm[1],tm[2].trim(),file)}
/* ===== vision ===== */
const small=f=>new Promise((ok,ko)=>{const i=new Image();i.onload=()=>{const k=Math.min(1,1024/Math.max(i.width,i.height)),c=document.createElement("canvas");c.width=i.width*k;c.height=i.height*k;c.getContext("2d").drawImage(i,0,0,c.width,c.height);ok(c.toDataURL("image/jpeg",.8))};i.onerror=ko;i.src=URL.createObjectURL(f)});
async function vision(file,q,b){
  if(!file)return say(b,"⚠️ Joins d'abord une image avec le bouton 📷 Vision.");
  b.innerHTML=typing("👁️ J'analyse l'image");let t;
  if(smp){
    if(!(lim&&lim.images))return say(b,"📷 L'analyse d'image n'est pas disponible ici.");
    t=(await smp("Décris cette image clairement, en français, et réponds à la demande de l'utilisateur"+(q?" : "+q:".")+" Ton cool et précis.",{images:file,cache:false,signal:ctl.signal,onText:({text})=>{b.innerHTML=md(text);down()}})).text
  }else{
    const r=await net(CFG.VIS,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({imageUrl:await small(file),question:q||"Décris cette image clairement, en français."})});
    const d=await r.json();t=d.description||d.text||d.error||"❌ Impossible d'analyser cette image."}
  say(b,t);pushH("assistant",t)}
/* ===== images ===== */
async function pic(kind,prompt,b){
  b.innerHTML=typing(kind=="map"?"🗺️ Je dessine la carte":"🎨 Je crée l'image");let o;
  if(smp){
    const ask=kind=="map"?"Dessine une carte schématique stylisée (pas à l'échelle) de : "+prompt+". Lieux clés étiquetés, légende, rose des vents, style moderne très coloré.":"Crée une illustration artistique riche, colorée et soignée de : "+prompt+".";
    const r=await smp(ask+'\nRéponds UNIQUEMENT avec un SVG complet et valide (<svg viewBox="0 0 800 600" xmlns="http://www.w3.org/2000/svg">…</svg>), sans texte autour, sans script, sans image externe, avec dégradés et formes.',{cache:false,signal:ctl.signal});
    const m=(r.text||"").match(/<svg[\s\S]*<\/svg>/i);if(!m)throw{code:"bad"};
    const s=m[0].replace(/<script[\s\S]*?<\/script>/gi,"").replace(/<foreignObject[\s\S]*?<\/foreignObject>/gi,"").replace(/\son\w+\s*=\s*("[^"]*"|'[^']*')/gi,"").replace(/(xlink:)?href\s*=\s*("(?!#)[^"]*"|'(?!#)[^']*')/gi,"");
    o={svg:s,src:"data:image/svg+xml;charset=utf-8,"+encodeURIComponent(s)}
  }else{
    const q=kind=="map"?"A detailed realistic geographic map showing the location of "+prompt+", satellite view with pin marker":prompt;
    const d=await jget(CFG.IMG+"?prompt="+encodeURIComponent(q)),u=typeof d=="string"?d:(d&&(d.response||d.url||d.image));
    if(!u||!/^https:/.test(u))throw{code:"bad"};let bl=null;try{bl=await blobOf(u)}catch(e){}o=bl?{blob:bl,src:URL.createObjectURL(bl)}:{url:u,src:u}}
  const name="neo_"+(kind=="map"?"carte_":"image_")+Date.now(),png=()=>o.svg?svgToPng(o.svg):Promise.resolve(o.blob||null),ext=o.svg?"png":((o.blob?o.blob.type.split("/")[1]:"jpg")||"jpg").replace("jpeg","jpg");
  const i=new Image();i.className="gi";i.alt=prompt;i.src=o.src;i.onclick=()=>lb(o.src,png,name+"."+ext);
  const c=document.createElement("div");c.className="cap";c.textContent=(kind=="map"?(o.svg?"🗺️ Carte schématique, pas à l'échelle : ":"🗺️ "):"🎨 ")+prompt;
  b.innerHTML="";b.append(i,c);const row=document.createElement("div");row.className="row";
  btn(row,"⬇ Télécharger",async()=>{const b=await png();b?save(b,name+"."+ext):window.open(o.src,"_blank")});
  if(o.svg)btn(row,"⬇ SVG",()=>save(new Blob([o.svg],{type:"image/svg+xml"}),name+".svg"));
  b.append(row);down();pushH("assistant",(kind=="map"?"🗺️ Carte : ":"🎨 Image : ")+prompt)}
/* ===== pinterest ===== */
async function pin(q,b){
  if(smp)return say(b,"📌 Pinterest n'est pas disponible dans claude.ai (pas d'accès aux sites externes). Il fonctionne sur ton déploiement.");
  b.innerHTML=typing("📌 Recherche Pinterest");
  const d=await jget(CFG.PIN+"?query="+encodeURIComponent(q)),arr=(Array.isArray(d)?d:d&&(d.data||d.pins||d.results))||[];
  const urls=arr.map(p=>typeof p=="string"?p:p&&(p.image||p.url)).filter(Boolean);
  if(!urls.length)return say(b,"❌ Aucun résultat Pinterest.");
  pins={q,urls,page:0};renderPins(b);pushH("assistant","📌 Pinterest : "+q)}
function renderPins(b){
  const s=pins.page*10,tot=Math.ceil(pins.urls.length/10);b.innerHTML="";
  const g=document.createElement("div");g.className="pg";
  pins.urls.slice(s,s+10).forEach((u,i)=>{const n="pinterest_"+(s+i+1)+".jpg",t=document.createElement("div"),im=new Image();t.className="pt";im.loading="lazy";im.src=u;im.onclick=()=>lb(u,()=>blobOf(u),n);t.append(im);btn(t,"⬇",()=>dlUrl(u,n),"");g.append(t)});
  const c=document.createElement("div");c.className="cap";c.textContent="📌 "+pins.q+" — page "+(pins.page+1)+"/"+tot;
  b.append(g,c);const row=document.createElement("div");row.className="row";
  if(pins.page>0)btn(row,"◂ Précédent",()=>{pins.page--;renderPins(b)});
  if(pins.page<tot-1)btn(row,"Suivant ▸",()=>{pins.page++;renderPins(b)});
  b.append(row);down()}
/* ===== actions ===== */
async function act(k,arg,file){
  const b=add("assistant","");
  if(k=="IMAGINE")return pic("img",arg,b);
  if(k=="MAP")return pic("map",arg,b);
  if(k=="VISION")return vision(file,arg,b);
  if(k=="PIN")return pin(arg,b);
  const t=arg.slice(0,300);say(b,"🎙️ "+t);speak(t)}
async function send(text){
  text=(text||"").trim();if(busy||(!text&&!pend))return;
  if(!chat.querySelector(".m"))chat.innerHTML="";
  const file=pend,ub=add("user",text||"📷");
  if(file){const i=new Image(),n=file.name||"photo.jpg";i.src=URL.createObjectURL(file);i.className="gi";i.onclick=()=>lb(i.src,()=>file,n);ub.prepend(i);btn(ub.parentNode,"⬇ Télécharger la photo",()=>save(file,n))}
  clearPend();inp.value="";inp.style.height="auto";pushH("user",text||"[image jointe]");
  setBusy(true);ctl=new AbortController();
  const bot=add("assistant","");bot.innerHTML=typing();
  const low=text.toLowerCase(),rest=text.replace(/^\S+\s*/,""),isV=/^(vision|voir|describe)(\s|$)/.test(low);
  try{
    if(!smp&&window.claude&&claude.use)smp=await claude.use("sample");
    if(window.claude&&!smp)throw{code:"none"};
    const nm=text.match(/^(je m'appelle|mon nom est)\s+(.+)/i);if(nm){mem.name=nm[2].trim().slice(0,40);save0()}
    if(isV||(file&&!/^(imagine|carte|map|say|pin)\s/.test(low)))await vision(file,isV?rest:text,bot);
    else if(/^imagine\s/.test(low))await pic("img",rest,bot);
    else if(/^(carte|map)\s/.test(low))await pic("map",rest,bot);
    else if(/^pin\s/.test(low))await pin(rest,bot);
    else if(/^say\s/.test(low)){const t=rest.slice(0,300);say(bot,speak(t)?"🎙️ "+t:"🔇 La voix n'est pas disponible sur cet appareil.");pushH("assistant","🎙️ "+t)}
    else await chatAI(bot,file);
  }catch(e){
    const c=e&&e.code,part=((e&&e.text)||"").split(TRG)[0].trim();
    if(part){say(bot,part);pushH("assistant",part)}
    else{bot.textContent=ERR[c]||"😕 Oups, une erreur est survenue. Réessaie.";if(!ERR[c]&&mem.hist.length&&mem.hist[mem.hist.length-1].role=="user"){mem.hist.pop();save0()}}
  }
  setBusy(false);ctl=null;save0()}
$("#f").onsubmit=e=>{e.preventDefault();busy?ctl&&ctl.abort():send(inp.value)};
inp.onkeydown=e=>{if(e.key=="Enter"&&!e.shiftKey&&!/Android|iPhone|iPad/i.test(navigator.userAgent)){e.preventDefault();$("#f").requestSubmit()}};
inp.oninput=()=>{inp.style.height="auto";inp.style.height=Math.min(inp.scrollHeight,140)+"px"};
document.querySelectorAll("[data-p]").forEach(b=>b.onclick=()=>{inp.value=b.dataset.p;inp.focus()});
$("#fi").onchange=e=>setPend(e.target.files[0]);$("#px").onclick=clearPend;
$("#nw").onclick=()=>{if(busy&&ctl)ctl.abort();mem.hist=[];save0();clearPend();draw()};
$("#th").onclick=()=>{const d=document.documentElement,dark=d.dataset.theme?d.dataset.theme=="dark":matchMedia("(prefers-color-scheme:dark)").matches;d.dataset.theme=dark?"light":"dark";try{localStorage.setItem("neo_t",d.dataset.theme)}catch(e){}};
/* ===== comptes (Firebase : email + Google) ===== */
const AU=$("#auth"),aerr=m=>{$("#ae").textContent=m};
const EM={"auth/invalid-email":"Email invalide.","auth/user-not-found":"Compte introuvable.","auth/wrong-password":"Mot de passe incorrect.","auth/invalid-credential":"Email ou mot de passe incorrect.","auth/email-already-in-use":"Cet email a déjà un compte.","auth/weak-password":"Mot de passe trop court (6 caractères min).","auth/popup-closed-by-user":"Connexion annulée.","auth/network-request-failed":"Pas de connexion internet.","auth/too-many-requests":"Trop d'essais, réessaie plus tard.","auth/unauthorized-domain":"Domaine non autorisé dans Firebase (Authentication > Paramètres)."};
const afail=e=>aerr(EM[e.code]||"Erreur : "+(e.code||e.message||""));
if(FB){
  FB.a.onAuthStateChanged(async u=>{
    user=u;const me=$("#me");
    if(!u){MK="neo_m";loadLocal();me.hidden=true;AU.hidden=!!sessionStorage.getItem("neo_guest");draw();return}
    sessionStorage.removeItem("neo_guest");AU.hidden=true;MK="neo_m_"+u.uid;loadLocal();
    me.hidden=false;me.innerHTML="";if(u.photoURL){const i=new Image();i.src=u.photoURL;i.referrerPolicy="no-referrer";me.append(i)}else me.textContent=(u.displayName||u.email||"?")[0].toUpperCase();
    try{const sn=await FB.d.doc("users/"+u.uid).get();if(sn.exists){const d=sn.data(),c=(d.hist||[]).filter(h=>Date.now()-h.t<30*864e5);if(c.length>=mem.hist.length)mem.hist=c;mem.name=d.name||mem.name}}catch(e){}
    if(!mem.name&&u.displayName)mem.name=u.displayName.split(" ")[0];
    save0();draw()});
  $("#agoo").onclick=()=>{aerr("");FB.a.signInWithPopup(new firebase.auth.GoogleAuthProvider()).catch(afail)};
  $("#alog").onclick=()=>{aerr("");FB.a.signInWithEmailAndPassword($("#aem").value.trim(),$("#apw").value).catch(afail)};
  $("#areg").onclick=async()=>{aerr("");try{const c=await FB.a.createUserWithEmailAndPassword($("#aem").value.trim(),$("#apw").value),n=$("#anm").value.trim();if(n){await c.user.updateProfile({displayName:n});mem.name=n;save0()}}catch(e){afail(e)}};
  $("#afor").onclick=()=>{const em=$("#aem").value.trim();if(!em)return aerr("Entre d'abord ton email.");FB.a.sendPasswordResetEmail(em).then(()=>aerr("📧 Email de réinitialisation envoyé.")).catch(afail)};
  $("#agst").onclick=()=>{sessionStorage.setItem("neo_guest","1");AU.hidden=true};
  $("#me").onclick=()=>{$("#mpt").textContent=(user.displayName||"")+"\n"+(user.email||"");$("#mp").hidden=!$("#mp").hidden};
  $("#out").onclick=()=>{$("#mp").hidden=true;sessionStorage.removeItem("neo_guest");FB.a.signOut()};
}
draw();
(async()=>{try{if(window.claude&&claude.use){smp=await claude.use("sample");if(smp)lim=await smp.limits().catch(()=>null)}}catch(e){}
  const L=imgLim();if(L){$("#cam").hidden=false;$("#fi").accept=L.mediaTypes.join(",")}if(smp)$("#pinb").hidden=true})();
</script></body></html>
